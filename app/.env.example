# Frontend build configuration (Vite). Copy to .env.local for local development.

# URL of the deployed Neon Function (from `neon functions get hifdhapi`), or the local dev API.
# Leave empty to build a fully local app with no account features.
VITE_API_URL=http://localhost:8787

# Path the app is served from. "/" locally; "/<repository>/" on GitHub Pages project sites.
VITE_BASE=/
