# Backend configuration. Copy to .env for local use; on Neon, DATABASE_URL is injected and
# ALLOWED_ORIGINS is set at deploy time (see neon.ts). Never commit a real .env.

# Postgres. `neon env pull` writes both for a linked branch. Leave unset locally to use PGlite.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# Exact browser origins allowed to call the API (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://YOUR-GITHUB-USER.github.io,http://localhost:5174
